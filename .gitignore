# Installed dependencies — restored by `npm install`, never committed (66 MB).
node_modules/

# Build output — regenerated by `./package-windows.sh` (227 MB).
dist/

# Unpacked .deb payloads holding Linux browser libraries this WSL image lacks.
# Machine- and architecture-specific, and 7.6 MB; see WSL-COMPATIBILITY.md to recreate.
.wsl-browser-libs/

# Windows metadata that WSL surfaces as real files. The colon in the name is also
# illegal on NTFS, so these break any copy back to Windows.
*:Zone.Identifier
*:sec.endpointdlp

# Playwright's downloaded browsers, if a local cache is ever used.
.playwright/

# Editor and OS noise.
.DS_Store
*.swp

# Claude Code session state and worktrees. Worktrees are separate checkouts of this
# same repository, so committing one would nest the repo inside itself.
.claude/
